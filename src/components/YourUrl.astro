---
/**
 * "Your Durable Runner URL": the reader enters their server once, and every code block on the page
 * (and what its copy button copies) shows it in place of https://runner.example.com, the reserved
 * example domain the pages are written with. Kept in this browser only (localStorage), never sent
 * anywhere; https:// only, or plain http:// for this machine. Reset puts the example back.
 */
---

<div class="your-url not-content print:hidden" data-your-url>
	<p class="your-url-compact">
		<span>Examples: <code data-current>https://runner.example.com</code></span>
		<span aria-hidden="true">·</span>
		<button type="button" class="your-url-change" aria-expanded="false" aria-controls="your-url-form">Change</button>
	</p>
	<form class="your-url-form" id="your-url-form" novalidate>
		<label for="your-url-input">Your Durable Runner URL</label>
		<div class="your-url-row">
			<input
				id="your-url-input"
				name="url"
				type="url"
				inputmode="url"
				autocomplete="url"
				spellcheck="false"
				placeholder="https://runner.example.com"
				aria-describedby="your-url-status"
			/>
			<button type="submit">Use</button>
			<button type="button" data-reset>Reset</button>
		</div>
		<p id="your-url-status" class="your-url-status" role="status" aria-live="polite"></p>
	</form>
</div>

<script>
	import { EXAMPLE, parseRunnerUrl, readStoredUrl, writeStoredUrl } from '../lib/your-url';

	/** Each code text node's own text, as the page was built, so applying and resetting are exact. */
	const original = new WeakMap<Node, string>();
	const originalCopy = new WeakMap<HTMLElement, string>();

	function apply(url: string) {
		for (const block of document.querySelectorAll('.sl-markdown-content pre')) {
			const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
			for (let node = walker.nextNode(); node; node = walker.nextNode()) {
				if (!original.has(node)) {
					if (!node.nodeValue?.includes(EXAMPLE)) continue;
					original.set(node, node.nodeValue);
				}
				node.nodeValue = (original.get(node) ?? '').replaceAll(EXAMPLE, url);
			}
		}
		// Expressive Code's copy button copies its data-code attribute, not the visible text.
		for (const button of document.querySelectorAll<HTMLElement>('.sl-markdown-content [data-code]')) {
			if (!originalCopy.has(button)) {
				if (!button.dataset.code?.includes(EXAMPLE)) continue;
				originalCopy.set(button, button.dataset.code);
			}
			button.dataset.code = (originalCopy.get(button) ?? '').replaceAll(EXAMPLE, url);
		}
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-your-url]')) {
		const form = root.querySelector('form');
		const input = root.querySelector('input');
		const status = root.querySelector('.your-url-status');
		const reset = root.querySelector('[data-reset]');
		if (!form || !input || !status || !reset) continue;

		const change = root.querySelector<HTMLButtonElement>('.your-url-change');
		const current = root.querySelector('[data-current]');
		// On a phone the control is one line until "Change" opens the field.
		const setOpen = (open: boolean) => {
			root.toggleAttribute('data-open', open);
			change?.setAttribute('aria-expanded', String(open));
		};
		change?.addEventListener('click', () => {
			const open = change.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
			if (open) input.focus();
		});

		const show = (url: string, note = '') => {
			apply(url);
			if (current) current.textContent = url;
			input.value = url === EXAMPLE ? '' : url;
			status.textContent =
				url === EXAMPLE
					? `Examples use ${EXAMPLE}, a reserved example domain. Enter your server to see your own.`
					: `Examples use ${url}. Kept in this browser only.${note ? ` ${note}` : ''}`;
		};

		const stored = readStoredUrl();
		show(stored?.url ?? EXAMPLE, stored?.note);

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (input.value.trim() === '') {
				writeStoredUrl(null);
				show(EXAMPLE);
				return;
			}
			const parsed = parseRunnerUrl(input.value);
			if ('error' in parsed) {
				status.textContent = parsed.error;
				return;
			}
			writeStoredUrl(parsed.url);
			show(parsed.url, parsed.note);
		});
		reset.addEventListener('click', () => {
			writeStoredUrl(null);
			show(EXAMPLE);
		});
	}
</script>

<style>
	.your-url {
		margin-top: 1rem;
		padding: 0.875rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 16px;
		background: var(--c-surface);
		font-size: var(--sl-text-sm);
	}
	.your-url label {
		display: block;
		font-weight: 600;
		margin-bottom: 0.375rem;
	}
	.your-url-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.your-url input {
		flex: 1 1 14rem;
		min-width: 0;
		font: inherit;
		font-family: var(--__sl-font-mono, ui-monospace, monospace);
		font-size: var(--sl-text-sm);
		height: 2.375rem;
		padding: 0 0.75rem;
		color: var(--sl-color-white);
		background: var(--sl-color-bg);
		border: 1px solid var(--c-line-strong);
		border-radius: 12px;
	}
	.your-url button {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 520;
		height: 2.375rem;
		padding: 0 0.875rem;
		border-radius: 12px;
		border: 1px solid var(--c-line-strong);
		background: var(--c-card);
		color: var(--sl-color-white);
		cursor: pointer;
		transition: background-color 150ms ease-out;
	}
	.your-url button:hover {
		background: var(--c-hover);
	}
	/* "Use" is the brand button: white on vermilion in both themes (src/styles/theme.css .btn-brand). */
	.your-url button[type='submit'] {
		border: 0;
		color: var(--c-on-cta);
		background-color: var(--c-cta);
		background-image: linear-gradient(180deg, var(--c-cta-hi) 0%, var(--c-cta) 36%);
		box-shadow:
			inset 0 1px 0 var(--c-glass-edge),
			0 6px 14px -6px var(--c-brand-shade);
	}
	.your-url button[type='submit']:hover {
		background-color: var(--c-cta-hover);
		background-image: linear-gradient(180deg, var(--c-cta-hi) 0%, var(--c-cta-hover) 36%);
	}
	.your-url-compact {
		display: none;
		margin: 0;
		align-items: baseline;
		gap: 0.375rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		white-space: nowrap;
	}
	.your-url-compact > span:first-child {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.your-url .your-url-change {
		flex: none;
		height: auto;
		padding: 0;
		border: 0;
		background: none;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-text-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	/* On a phone: one line, "Examples use … · Change", until Change opens the field. */
	@media (max-width: 30rem) {
		.your-url {
			padding: 0.5rem 0.625rem;
		}
		.your-url-compact {
			gap: 0.25rem;
		}
		.your-url-compact code {
			font-size: 0.75rem;
			padding: 0;
			background: none;
		}
		.your-url-compact {
			display: flex;
		}
		.your-url:not([data-open]) .your-url-form {
			display: none;
		}
		.your-url[data-open] .your-url-form {
			margin-top: 0.5rem;
		}
		.your-url-row {
			flex-wrap: nowrap;
		}
		.your-url input {
			flex: 1 1 auto;
		}
	}
	.your-url-status {
		margin: 0.5rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
	}
</style>
