---
/**
 * The theme switch, the same as the landing page's: one button between light and dark that follows the
 * system until pressed; pressing onto the system's own scheme goes back to following it. It replaces
 * Starlight's Auto/Light/Dark select (in the header and the phone's menu) and keeps Starlight's storage:
 * `starlight-theme` holds 'light' or 'dark' for a choice and '' for following the system, so Starlight's
 * inline ThemeProvider still applies a stored choice before the first paint. The new theme grows from the
 * button as a circle (a view transition, on click only) unless motion is reduced or the browser has none.
 * The moon shows in light, the sun in dark; Starlight always sets data-theme, so CSS picks the icon.
 */
---

<dr-theme-toggle>
	<button type="button" class="dr-theme" aria-label="Dark theme" aria-pressed="false" title="Switch to dark (following your system)">
		<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
		</svg>
		<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2m-7.07-14.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
		</svg>
	</button>
</dr-theme-toggle>

<script>
	const key = 'starlight-theme'
	const root = document.documentElement
	const system = matchMedia('(prefers-color-scheme: dark)')
	const stored = () => {
		try {
			const v = localStorage.getItem(key)
			return v === 'light' || v === 'dark' ? v : ''
		} catch {
			return ''
		}
	}
	const store = (v: string) => {
		try {
			localStorage.setItem(key, v)
		} catch {}
	}
	const isDark = () => root.dataset.theme === 'dark'
	const sync = () => {
		const dark = isDark()
		for (const b of document.querySelectorAll<HTMLButtonElement>('.dr-theme')) {
			b.setAttribute('aria-pressed', String(dark))
			b.title = `${dark ? 'Switch to light' : 'Switch to dark'}${stored() ? '' : ' (following your system)'}`
		}
	}
	const apply = (next: 'light' | 'dark') => {
		const follow = next === (system.matches ? 'dark' : 'light')
		root.dataset.theme = next
		store(follow ? '' : next)
		sync()
	}
	// following the system: track it when it changes
	system.addEventListener('change', () => {
		if (!stored()) root.dataset.theme = system.matches ? 'dark' : 'light'
		sync()
	})

	class DrThemeToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector<HTMLButtonElement>('button')
			if (!button) return
			sync()
			button.addEventListener('click', () => {
				const next = isDark() ? 'light' : 'dark'
				if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply(next)
				const box = button.getBoundingClientRect()
				const x = box.left + box.width / 2
				const y = box.top + box.height / 2
				const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
				document.startViewTransition(() => apply(next)).ready.then(() =>
					root.animate(
						{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
						{ duration: 480, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
					),
				)
			})
		}
	}
	customElements.define('dr-theme-toggle', DrThemeToggle)
</script>

<style>
	dr-theme-toggle {
		display: flex;
	}
	.dr-theme {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 0;
		border-radius: 12px;
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition: background-color 150ms ease-out;
	}
	.dr-theme:hover {
		background: var(--c-hover);
	}
	.dr-theme svg {
		width: 17px;
		height: 17px;
	}
	:root[data-theme='dark'] .dr-theme .moon,
	:root[data-theme='light'] .dr-theme .sun {
		display: none;
	}
</style>
