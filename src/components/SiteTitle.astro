---
/**
 * The site title: Durable Runner's app icon (three journal frames on the vermilion tile, the front
 * one committed), the name, and a muted "Docs", linking to the docs home. The same tile as the
 * landing page and public/favicon.svg; decorative here, since the name is beside it.
 */
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" translate="no">
	<span class="tile" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linejoin="round">
			<rect x="9.6" y="4.2" width="10.2" height="10.2" rx="2.6" stroke-width="1.6" opacity="0.6"></rect>
			<rect x="6.9" y="6.9" width="10.2" height="10.2" rx="2.6" stroke-width="1.6" opacity="0.85"></rect>
			<rect x="4.2" y="9.6" width="10.2" height="10.2" rx="2.6" fill="currentColor" stroke-width="1.6"></rect>
		</svg>
	</span>
	<span class="name">Durable Runner</span> <span class="label">Docs</span>
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5625rem;
		min-width: 0;
		border-radius: 10px;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.tile {
		--s: 30px;
		display: inline-grid;
		place-items: center;
		flex: none;
		width: var(--s);
		height: var(--s);
		border-radius: calc(var(--s) * 0.27);
		color: var(--c-on-brand);
		background:
			radial-gradient(120% 90% at 22% 8%, var(--c-brand-glow) 0%, transparent 48%),
			linear-gradient(150deg, var(--c-brand-1) 0%, var(--c-brand-2) 100%);
		box-shadow:
			inset 0 0 0 1px var(--c-brand-edge),
			inset 0 -6px 12px -6px var(--c-brand-shade);
	}
	.tile svg {
		width: 58%;
		height: 58%;
	}
	.name {
		font-size: 1.125rem;
		font-weight: 560;
		letter-spacing: -0.018em;
		line-height: 1;
	}
	.label {
		margin-inline-start: -0.125rem;
		font-size: 1.125rem;
		font-weight: 420;
		letter-spacing: -0.01em;
		line-height: 1;
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 30rem) {
		.tile {
			--s: 28px;
		}
		.name,
		.label {
			font-size: 1.0625rem;
		}
	}
</style>
