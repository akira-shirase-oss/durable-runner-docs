---
/**
 * The API reference: Scalar's renderer over Durable Runner's OpenAPI document (/openapi.json — a
 * draft authored in this repository and kept in sync with the server's routes by
 * scripts/check-openapi.mjs). Scalar runs from this site's own copy of its browser build, at the
 * version package.json pins, with its telemetry, hosted fonts and AI assistant switched off.
 * A full-width page of its own, since Scalar brings its own navigation.
 */
import spec from '../../data/openapi.json';

const title = 'API reference · Durable Runner Docs';
const description =
	'Every route of Durable Runner’s HTTP API — jobs, cancel, admin and health — generated from its OpenAPI document, with request examples and try-it.';
const canonical = new URL('/api/reference/', Astro.site).href;
const paths = Object.keys(spec.paths).length;
const operations = Object.values(spec.paths).reduce(
	(sum: number, item) => sum + Object.keys(item as object).filter((key) => ['get', 'post', 'put', 'patch', 'delete'].includes(key)).length,
	0,
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preload" href="/fonts/google-sans-flex-latin.woff2" as="font" type="font/woff2" crossorigin />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<script is:inline>
			// The docs' own theme choice, so this page opens in the same light or dark.
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('starlight-theme');
				} catch {}
				const dark = stored === 'dark' || ((stored === null || stored === 'auto' || stored === '') && matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.dataset.theme = dark ? 'dark' : 'light';
			})();
		</script>
		<style is:global>
			/* The docs' design system on a page of its own (src/styles/theme.css holds the full palette):
			   the same webfont, page, ink, hairline and deep-vermilion accent. */
			@font-face {
				font-family: 'Google Sans Flex';
				font-style: normal;
				font-weight: 100 1000;
				font-display: swap;
				src: url('/fonts/google-sans-flex-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
					U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			:root {
				--ink: #1e1e1e;
				--muted: #5c5c5c;
				--line: #ebebeb;
				--bg: #ffffff;
				--accent: #c9431a;
				--focus: #c9431a;
				--brand-1: #ff9a5c;
				--brand-2: #f0501f;
				--brand-glow: #ffd9c2;
				--brand-edge: #ffffff40;
				--brand-shade: #b8340f55;
				color-scheme: light;
			}
			:root[data-theme='dark'] {
				--ink: #f1f1f1;
				--muted: #a3a3a3;
				--line: #24262a;
				--bg: #0d0e10;
				--accent: #ff8a5c;
				--focus: #ff8a5c;
				color-scheme: dark;
			}
			html,
			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: 'Google Sans Flex', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
				font-optical-sizing: auto;
				-webkit-font-smoothing: antialiased;
			}
			:focus-visible {
				outline: 2px solid var(--focus);
				outline-offset: 2px;
			}
			/* The page's heading is for screen readers; Scalar's own title is the visible one. This page
			   doesn't load the docs' theme.css, so the class is defined here too. */
			.visually-hidden {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}
			.ref-bar {
				position: sticky;
				top: 0;
				z-index: 20;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem 1rem;
				min-height: 4rem;
				box-sizing: border-box;
				padding: 0.625rem 1.5rem;
				background: var(--bg);
				border-bottom: 1px solid var(--line);
				font-size: 0.875rem;
			}
			@media (max-width: 50rem) {
				.ref-bar {
					padding-inline: 1rem;
				}
			}
			.ref-bar a {
				color: inherit;
				text-decoration: none;
			}
			.ref-home {
				display: inline-flex;
				align-items: center;
				gap: 0.5625rem;
				border-radius: 10px;
				font-size: 1.125rem;
				font-weight: 560;
				letter-spacing: -0.018em;
			}
			.ref-home .label {
				margin-inline-start: -0.125rem;
				font-weight: 420;
				color: var(--muted);
			}
			.ref-tile {
				display: inline-grid;
				place-items: center;
				flex: none;
				width: 30px;
				height: 30px;
				border-radius: 8px;
				color: #ffffff;
				background:
					radial-gradient(120% 90% at 22% 8%, var(--brand-glow) 0%, transparent 48%),
					linear-gradient(150deg, var(--brand-1) 0%, var(--brand-2) 100%);
				box-shadow:
					inset 0 0 0 1px var(--brand-edge),
					inset 0 -6px 12px -6px var(--brand-shade);
			}
			.ref-tile svg {
				width: 58%;
				height: 58%;
			}
			.ref-crumb {
				color: var(--muted);
			}
			.ref-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1rem;
				margin-inline-start: auto;
				color: var(--muted);
			}
			.ref-links a {
				transition: color 150ms ease-out;
			}
			.ref-links a:hover {
				color: var(--ink);
			}
			.ref-note {
				margin: 0;
				padding: 0.625rem 16px;
				font-size: 0.8125rem;
				line-height: 1.5;
				color: var(--muted);
				border-bottom: 1px solid var(--line);
			}
			.ref-note code {
				font-size: 0.95em;
			}
			.ref-note a {
				color: var(--accent);
				text-underline-offset: 0.22em;
			}
			noscript p {
				padding: 1rem 16px;
			}
		</style>
	</head>
	<body>
		<header class="ref-bar">
			<a class="ref-home" href="/" translate="no">
				<span class="ref-tile" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linejoin="round">
						<rect x="9.6" y="4.2" width="10.2" height="10.2" rx="2.6" stroke-width="1.6" opacity="0.6"></rect>
						<rect x="6.9" y="6.9" width="10.2" height="10.2" rx="2.6" stroke-width="1.6" opacity="0.85"></rect>
						<rect x="4.2" y="9.6" width="10.2" height="10.2" rx="2.6" fill="currentColor" stroke-width="1.6"></rect>
					</svg>
				</span>
				<span>Durable Runner</span> <span class="label">Docs</span>
			</a>
			<span class="ref-crumb" aria-hidden="true">/</span>
			<span class="ref-crumb">API reference</span>
			<nav class="ref-links" aria-label="Docs">
				<a href="/">Documentation</a>
				<a href="/openapi.json">openapi.json</a>
			</nav>
		</header>
		<main>
			<h1 class="visually-hidden">Durable Runner API reference</h1>
			<p class="ref-note">
				{operations} operations on {paths} paths, generated from the OpenAPI document this site serves at <code>/openapi.json</code>
				(version {spec.info.version}; a draft kept in sync with the server's routes by CI).
				The examples call <code>https://runner.example.com</code>, a reserved example domain; pick <strong>the quick start on this machine</strong>
				under <strong>Server</strong>, or set <strong>Your Durable Runner URL</strong> on an API page and it comes first here. Durable Runner's API doesn't
				answer browser requests from other sites, so <strong>Test Request</strong> from this page reaches your server only if the browser allows it:
				otherwise copy the request as <code>curl</code> from the code samples. Put a key in <strong>Authentication</strong> only for
				a local or test server. <a href="/">The docs</a>.
			</p>
			<div id="reference"></div>
			<noscript><p>The interactive reference needs JavaScript. The document itself is at <a href="/openapi.json">/openapi.json</a>.</p></noscript>
		</main>
		<script type="module" is:inline>
			import { createApiReference } from '/scalar/standalone.esm.js';
			// The reader's own server, if they set one on an API page (src/lib/your-url.ts holds the
			// same rule: https, or http for this machine; the origin only). Kept in this browser.
			const servers = [
				{ url: 'https://runner.example.com', description: 'Your Durable Runner (an example domain: enter yours on an API page)' },
				{ url: 'http://127.0.0.1:58300', description: 'The quick start on this machine' },
			];
			try {
				const stored = new URL(localStorage.getItem('durable-runner-docs:server') ?? '');
				const local = ['localhost', '127.0.0.1', '[::1]'].includes(stored.hostname);
				if (stored.protocol === 'https:' || (stored.protocol === 'http:' && local)) {
					servers.unshift({ url: stored.origin, description: 'Your Durable Runner' });
				}
			} catch {}
			const dark = document.documentElement.dataset.theme === 'dark';
			createApiReference('#reference', {
				url: '/openapi.json',
				servers,
				authentication: { preferredSecurityScheme: 'apiKey' },
				defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
				darkMode: dark,
				hideDarkModeToggle: true,
				withDefaultFonts: false,
				telemetry: false,
				showDeveloperTools: 'never',
				agent: { disabled: true },
				hideClientButton: false,
				persistAuth: false,
				// No request proxy. Test Request goes straight from the reader's browser to the server they
				// chose, never through proxy.scalar.com. Scalar 1.76 uses an explicit proxyUrl as given, and an
				// empty one means no proxy. Left unset, it falls back to its hosted proxy only in its own
				// "web" layout, which this page doesn't use. The empty value pins that down across upgrades,
				// and CI's privacy job (scripts/check-privacy.mjs) fails if a version starts proxying anyway. It
				// tries a remote https server as well as a local one, because Scalar never proxies localhost.
				proxyUrl: '',
				metaData: { title: 'API reference · Durable Runner Docs' },
				customCss: `
					.scalar-app, .scalar-api-reference { --scalar-font: 'Google Sans Flex', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif; --scalar-font-code: ui-monospace, SFMono-Regular, Menlo, monospace; --scalar-radius: 8px; --scalar-radius-lg: 12px; --scalar-radius-xl: 16px; }
					.light-mode { --scalar-color-accent: #c9431a; --scalar-background-1: #ffffff; --scalar-color-1: #1e1e1e; --scalar-color-2: #474747; --scalar-color-3: #5c5c5c; --scalar-border-color: #ebebeb; }
					.dark-mode { --scalar-color-accent: #ff8a5c; --scalar-background-1: #0d0e10; --scalar-color-1: #f1f1f1; --scalar-color-2: #c4c4c4; --scalar-color-3: #a3a3a3; --scalar-border-color: #24262a; }
				`,
			});
		</script>
	</body>
</html>
